{
  "scanSettings": {
    "configMode": "AUTO",
    "configExternalURL": "",
    "enableIaC": true,
    "baseBranches": [
      "main",
      "dev"
    ],
    "versioning": {
      "python": "3.12"
    }
  },
  "scanSettingsSAST": {
    "enableScan": true,
    "scanPullRequests": true,
    "incrementalScan": true,
    "baseBranches": [
      "main",
      "dev"
    ],
    "snippetSize": 10
  },
  "checkRunSettings": {
    "vulnerableCheckRunConclusionLevel": "failure",
    "displayMode": "diff",
    "useMendCheckNames": true,
    "iacCheckRunConclusionLevel": "failure"
  },
  "checkRunSettingsSAST": {
    "checkRunConclusionLevel": "failure",
    "severityThreshold": "high"
  },
  "issueSettings": {
    "minSeverityLevel": "LOW",
    "issueType": "DEPENDENCY"
  },
  "issueSettingsSAST": {
    "minSeverityLevel": "high",
    "issueType": "repo"
  },
  "remediateSettings": {
    "renovateStrategy": "disabled",
    "workflowRules": {
      "enabled": false
    }
  },
  "imageSettings": {
    "imageTracing": {
      "enableImageTracingPX": false,
      "addRepositoryCoordinate": false
    }
  },
  "hostRules": [
    {
      "matchHost": "https://lab-test-00172051-a.example.com/artifactory",
      "userName": "labuser",
      "envVariablesMapping": {
        "userName": "LAB_A_USER",
        "token": "LAB_A_TOKEN"
      },
      "encrypted": {
        "token": ""
      }
    },
    {
      "matchHost": "https://lab-test-00172051-b.example.com/artifactory",
      "hostType": "maven",
      "userName": "labuser",
      "envVariablesMapping": {
        "userName": "LAB_B_USER",
        "token": "LAB_B_TOKEN"
      },
      "encrypted": {
        "token": ""
      }
    }
  ]
}
